<opc:TypeDictionary xmlns:opc="http://opcfoundation.org/BinarySchema/" xmlns:ua="http://opcfoundation.org/UA/" TargetNamespace="http://opcfoundation.org/UA/FX/AC/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" DefaultByteOrder="LittleEndian" xmlns:tns="http://opcfoundation.org/UA/FX/AC/">
    <opc:Import Namespace="http://opcfoundation.org/UA/"/>
    <opc:StructuredType BaseType="ua:ExtensionObject" Name="AggregatedHealthDataType">
        <opc:Field Name="AggregatedDeviceHealth" TypeName="tns:DeviceHealthOptionSet"/>
        <opc:Field Name="AggregatedOperationalHealth" TypeName="tns:OperationalHealthOptionSet"/>
    </opc:StructuredType>
    <opc:StructuredType BaseType="ua:ExtensionObject" Name="ApplicationIdentifierDataType">
        <opc:Field Name="Name" TypeName="ua:LocalizedText"/>
        <opc:Field Name="UniqueIdentifier" TypeName="tns:ApplicationId"/>
    </opc:StructuredType>
    <opc:StructuredType BaseType="ua:ExtensionObject" Name="FxVersion">
        <opc:Field Name="Major" TypeName="opc:UInt16"/>
        <opc:Field Name="Minor" TypeName="opc:UInt16"/>
        <opc:Field Name="Build" TypeName="opc:UInt16"/>
        <opc:Field Name="SubBuild" TypeName="opc:UInt16"/>
    </opc:StructuredType>
    <opc:StructuredType BaseType="ua:ExtensionObject" Name="PublisherQosDataType">
        <opc:Field Name="QosCategory" TypeName="opc:CharArray"/>
        <opc:Field Name="NoOfDatagramQos" TypeName="opc:Int32"/>
        <opc:Field Name="DatagramQos" TypeName="ua:ExtensionObject" LengthField="NoOfDatagramQos"/>
    </opc:StructuredType>
    <opc:StructuredType BaseType="ua:ExtensionObject" Name="SubscriberQosDataType">
        <opc:Field Name="QosCategory" TypeName="opc:CharArray"/>
        <opc:Field Name="NoOfDatagramQos" TypeName="opc:Int32"/>
        <opc:Field Name="DatagramQos" TypeName="ua:ExtensionObject" LengthField="NoOfDatagramQos"/>
    </opc:StructuredType>
    <opc:StructuredType BaseType="ua:Union" Name="ApplicationId">
        <opc:Field Name="SwitchField" TypeName="opc:UInt32"/>
        <opc:Field Name="IdNumeric" SwitchValue="1" TypeName="opc:UInt32" SwitchField="SwitchField"/>
        <opc:Field Name="IdString" SwitchValue="2" TypeName="opc:CharArray" SwitchField="SwitchField"/>
        <opc:Field Name="IdGuid" SwitchValue="3" TypeName="opc:Guid" SwitchField="SwitchField"/>
        <opc:Field Name="IdByteString" SwitchValue="4" TypeName="opc:ByteString" SwitchField="SwitchField"/>
    </opc:StructuredType>
    <opc:EnumeratedType Name="ClampKindEnum" LengthInBits="32">
        <opc:EnumeratedValue Value="0" Name="Screw"/>
        <opc:EnumeratedValue Value="1" Name="Thumb"/>
    </opc:EnumeratedType>
    <opc:EnumeratedType Name="ConnectionEndpointStatusEnum" LengthInBits="32">
        <opc:Documentation>This enumeration defines the values of the FlcConnectionStatus of an FlcConnectionEndpointType. </opc:Documentation>
        <opc:EnumeratedValue Value="0" Name="Initial"/>
        <opc:EnumeratedValue Value="1" Name="Ready"/>
        <opc:EnumeratedValue Value="2" Name="PreOperational"/>
        <opc:EnumeratedValue Value="3" Name="Operational"/>
        <opc:EnumeratedValue Value="4" Name="Error"/>
    </opc:EnumeratedType>
    <opc:EnumeratedType Name="SocketKindEnum" LengthInBits="32">
        <opc:EnumeratedValue Value="0" Name="RJ45"/>
        <opc:EnumeratedValue Value="1" Name="M12"/>
    </opc:EnumeratedType>
    <opc:EnumeratedType IsOptionSet="true" Name="CommHealthOptionSet" LengthInBits="16">
        <opc:EnumeratedValue Value="0" Name="CommInitial"/>
        <opc:EnumeratedValue Value="1" Name="CommPreOperational"/>
        <opc:EnumeratedValue Value="2" Name="CommError"/>
    </opc:EnumeratedType>
    <opc:EnumeratedType IsOptionSet="true" Name="DeviceHealthOptionSet" LengthInBits="16">
        <opc:EnumeratedValue Value="0" Name="DeviceFailure"/>
        <opc:EnumeratedValue Value="1" Name="DeviceCheckFunction"/>
        <opc:EnumeratedValue Value="2" Name="DeviceMaintenanceRequired"/>
        <opc:EnumeratedValue Value="3" Name="DeviceOffSpec"/>
    </opc:EnumeratedType>
    <opc:EnumeratedType IsOptionSet="true" Name="OperationalHealthOptionSet" LengthInBits="32">
        <opc:EnumeratedValue Value="16" Name="OperationalWarning"/>
        <opc:EnumeratedValue Value="17" Name="OperationalError"/>
        <opc:EnumeratedValue Value="18" Name="SubOperationalWarning"/>
        <opc:EnumeratedValue Value="19" Name="SubOperationalError"/>
    </opc:EnumeratedType>
</opc:TypeDictionary>
