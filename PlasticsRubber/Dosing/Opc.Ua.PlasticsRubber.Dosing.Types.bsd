<opc:TypeDictionary xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="http://opcfoundation.org/UA/PlasticsRubber/Dosing/" xmlns:ua="http://opcfoundation.org/UA/" DefaultByteOrder="LittleEndian" TargetNamespace="http://opcfoundation.org/UA/PlasticsRubber/Dosing/" xmlns:opc="http://opcfoundation.org/BinarySchema/">
    <opc:Import Namespace="http://opcfoundation.org/UA/"/>
    <opc:EnumeratedType LengthInBits="32" Name="ComponentStateEnumeration">
        <opc:EnumeratedValue Name="Off" Value="0"/>
        <opc:EnumeratedValue Name="Ready" Value="1"/>
        <opc:EnumeratedValue Name="Dosing" Value="2"/>
        <opc:EnumeratedValue Name="Calibration" Value="3"/>
        <opc:EnumeratedValue Name="Error" Value="4"/>
        <opc:EnumeratedValue Name="Cleaning" Value="5"/>
        <opc:EnumeratedValue Name="Purging" Value="6"/>
        <opc:EnumeratedValue Name="Priming" Value="7"/>
    </opc:EnumeratedType>
    <opc:EnumeratedType LengthInBits="32" Name="DosingModeEnumeration">
        <opc:EnumeratedValue Name="ONLY_CONVEYING" Value="0"/>
        <opc:EnumeratedValue Name="VOLUMETRIC" Value="1"/>
        <opc:EnumeratedValue Name="GRAVIMETRIC" Value="2"/>
        <opc:EnumeratedValue Name="OTHER" Value="3"/>
    </opc:EnumeratedType>
</opc:TypeDictionary>
